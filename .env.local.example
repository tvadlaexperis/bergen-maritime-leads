# Copy this file to .env.local for local development.
# The app runs with only SESSION_SECRET set — Brønnøysund needs no key and the
# database falls back to a local SQLite file.

# --- Required ---------------------------------------------------------------
# Signs the session cookie (lib/auth.ts). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# --- Accounts (used by `npm run db:build` + first-run seeding) ------------
# Prefer the *_PASSWORD_HASH form so no plaintext lives in the environment —
# generate with:  npm run hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Optional shared read-only "guest" account (viewer role).
GUEST_EMAIL=
GUEST_PASSWORD_HASH=
GUEST_PASSWORD=

# --- Database ------------------------------------------------------------
# Optional in dev — without these, lib/db.ts uses ./local.db (gitignored).
# Required in production (Vercel's filesystem is read-only).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DB_PATH=

# --- Cron protection ---------------------------------------------------
# Checked by /api/cron/scan so only Vercel Cron can trigger a scan.
# Generate: openssl rand -base64 32
CRON_SECRET=

# --- Scan tuning (optional) -------------------------------------------
# Max companies the Brreg pass (accounts, roller, konsern, score) considers per
# run. The ~30s time budget is the real limit — keep this above the company
# count (~620) or it silently caps coverage. Default 150.
SCAN_BATCH=700
# Max companies the AI pass (Gemini analysis, website search, contact scrape)
# tries per run. Default 12. Only matters when GEMINI_API_KEY is set.
SCAN_AI_BATCH=12

# --- Durable rate limiting (optional) -----------------------------------
# Add an Upstash Redis integration from the Vercel Storage tab. Falls back to
# per-instance in-memory limiting when unset (Turso rate_limits table is the
# middle tier).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- FX ticker (optional) --------------------------------------------
# Set SKIP_FX=1 to hide the NOK exchange-rate strip in the header.
SKIP_FX=

# --- AI lead summary (optional) ----------------------------------------
# Google Gemini API key. Without it, the "Hvorfor aktuell" tab on a company
# page just shows "Ingen AI-vurdering ennå" — the summary is generated
# best-effort during scan/refresh (lib/scan.ts) and stored on the company row.
GEMINI_API_KEY=

# --- NAV job ads (optional) ---------------------------------------------
# Personal token for NAV's vacancy feed (pam-stilling-feed.nav.no), issued by
# NAV after a written agreement to their terms of use. Without it the
# recruitment step is skipped and company pages say job ads are off.
NAV_FEED_TOKEN=
# Local testing only: use NAV's rotating public token ("for experiments only"
# per NAV). Never set this in production.
# NAV_FEED_USE_PUBLIC_TOKEN=1

# Optional: key from a separate AI Studio project WITHOUT billing (free tier).
# Used only when GEMINI_API_KEY is rejected (spend cap / quota), and only for
# the AI assessment — not news/website search (no search quota on the free
# tier), never for reading contacts off websites (free tier inputs may be
# used by Google; GDPR). Without it, the AI
# step simply stops when the paid key hits its cap.
GEMINI_API_KEY_FREE=
